# ═══════════════════════════════════════════════════════════════════
# DRIVEIT Luxury — Environment Variables (reference/sample)
# Copy to `.env.local` for local dev, or fill the same keys in your
# deployment platform / docker-compose `.env` file for production.
# ═══════════════════════════════════════════════════════════════════
#
# The app now FAILS FAST when required secrets are missing, so every
# production deployment must define PAYLOAD_SECRET and AUTH_SECRET.
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# ──────────────────────────────────────────────────
# Required — Payload CMS
# ──────────────────────────────────────────────────
# Secret used to sign Payload admin sessions & JWT tokens.
PAYLOAD_SECRET=REPLACE_WITH_32_BYTE_RANDOM_STRING
# Postgres is the only supported database — lib/db.ts refuses to boot on
# anything else, so there is no local-file fallback to drift away from.
#   Local dev (docker compose -f docker-compose.yml -f docker-compose.local.yml up -d postgres):
#     postgres://driveit:<password>@localhost:55432/driveit
#   Inside the compose stack:
#     postgres://driveit:<password>@postgres:5432/driveit
DATABASE_URI=postgres://driveit:REPLACE_WITH_POSTGRES_PASSWORD@localhost:55432/driveit

# ──────────────────────────────────────────────────
# Housekeeping — expired checkout holds
# ──────────────────────────────────────────────────
# Shared secret for POST /api/cron/expire-holds, which closes abandoned checkout
# holds. The endpoint fails closed: without this set it returns 503 and never
# runs. The `scheduler` service in docker-compose.yml calls it every 15 minutes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=REPLACE_WITH_RANDOM_SECRET

# ──────────────────────────────────────────────────
# Media storage — Cloudinary
# ──────────────────────────────────────────────────
# When all three are set, CMS uploads go to Cloudinary and the database stores
# CDN links; when they are absent, uploads stay on local disk (fine for one
# container, impossible to share between replicas).
# Free plan is enough to start: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET
# Optional: the folder assets are stored under. Defaults to `driveit`.
CLOUDINARY_FOLDER=driveit

# ──────────────────────────────────────────────────
# Required — Auth.js / NextAuth
# ──────────────────────────────────────────────────
AUTH_SECRET=REPLACE_WITH_32_BYTE_RANDOM_STRING
# Public origin, used for OAuth callbacks and for links in emails/WhatsApp.
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Google OAuth (the only customer sign-in provider)
AUTH_GOOGLE_ID=YOUR_GOOGLE_CLIENT_ID
AUTH_GOOGLE_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# ──────────────────────────────────────────────────
# Email — Brevo (Transactional API & Marketing) / Resend
# ──────────────────────────────────────────────────
# Primary: Brevo API (300 free emails/day, automated receipts, reminders & marketing lists)
BREVO_API_KEY=xkeysib-your_brevo_api_key
BREVO_SENDER_EMAIL=concierge@yourdomain.com
BREVO_SENDER_NAME=DriveIt Luxury Concierge
BREVO_MARKETING_LIST_ID=2

# Alternative / Fallback: Resend
RESEND_API_KEY=re_your_api_key
EMAIL_FROM_ADDRESS=concierge@yourdomain.com
EMAIL_FROM_NAME=DriveIt Luxury Concierge

# ──────────────────────────────────────────────────
# WhatsApp (Meta Graph API) — booking confirmations
# ──────────────────────────────────────────────────
WHATSAPP_TOKEN=EAALyour_meta_token
WHATSAPP_PHONE_ID=your_phone_id
# Optional override, defaults to v22.0
WHATSAPP_API_VERSION=v22.0

# ──────────────────────────────────────────────────
# WaCRM webhook bridge (outbound). Inbound calls must be
# signed with WACRM_WEBHOOK_SECRET or they are rejected.
# ──────────────────────────────────────────────────
WACRM_WEBHOOK_URL=
WACRM_WEBHOOK_SECRET=

# ──────────────────────────────────────────────────
# Internal notifications (server-side only — never prefix with NEXT_PUBLIC_)
# ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ──────────────────────────────────────────────────
# Payments (UPI)
# ──────────────────────────────────────────────────
NEXT_PUBLIC_UPI_ID=YOUR_UPI_ID@upi
NEXT_PUBLIC_UPI_NAME=DRIVEIT Luxury

# ──────────────────────────────────────────────────
# Rate limiting
# ──────────────────────────────────────────────────
# Set this on any deployment running more than one app instance. Without it the
# limiter uses per-process counters, so each instance allows the full quota.
#   redis://redis:6379      (the docker-compose service)
#   rediss://…              (TLS, e.g. a managed Redis)
REDIS_URL=
# Number of proxies between the client and the app. 1 = nginx/Traefik directly
# in front. Raise it only if you add another load balancer in front of nginx.
TRUSTED_PROXY_HOPS=1

# ──────────────────────────────────────────────────
# Schema management
# ──────────────────────────────────────────────────
# Development pushes the schema automatically. In production leave this unset
# and run `npm run migrate`; set it to `true` only for the very first deploy of
# an empty database (lets Payload create the tables on boot).
PAYLOAD_SCHEMA_PUSH=

# ──────────────────────────────────────────────────
# Seeding (`npm run seed`) — optional
# ──────────────────────────────────────────────────
# Without these, the seed generates a strong password and prints it once.
SEED_ADMIN_EMAIL=admin@driveitluxury.com
SEED_ADMIN_PASSWORD=
# Where the running instance lives (defaults to NEXT_PUBLIC_SERVER_URL).
SEED_BASE_URL=http://localhost:3000

# ──────────────────────────────────────────────────
# Optional widgets & Phase 2 Roadmap
# ──────────────────────────────────────────────────
NEXT_PUBLIC_TIDIO_CODE=
# Google Maps JavaScript API & Places API Key (Phase 2 Roadmap)
# Set up at: https://console.cloud.google.com/google/maps-apis
# Free tier: $200/month recurring credit (~11,700 autocomplete sessions/mo free).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
